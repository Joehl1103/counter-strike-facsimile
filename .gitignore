# Raw authoring packs stay in private local storage; never commit them.
/assets/source/

# Downloaded authoring tools and unselected source packs; provenance stays local.
/assets/source/mpfb/vendor/
/assets/source/mpfb/*.zip
/assets/source/mpfb/packs/*.zip
/assets/source/mpfb/packs/makehuman_system_assets/
/assets/source/mpfb/packs/suits03/
/assets/source/mpfb/packs/gloves01/
/assets/source/mpfb/packs/hats02/
/assets/source/mpfb/packs/masks01/
/assets/source/mpfb/packs/masks02/
