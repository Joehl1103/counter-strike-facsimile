{
  "name": "dustline-tactical-fps",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "test": "npm run test:regression && npm run test:performance",
    "lint": "oxlint app tests scripts",
    "format": "oxfmt",
    "test:regression": "node --test --test-concurrency=1 --test-skip-pattern='^8-bot movement presentation stays allocation-stable and under the 60 Hz p95 gate$' tests/*.test.ts",
    "test:performance": "node --test tests/movement-presentation-performance.test.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "visual:setup": "node scripts/setup-visual-tools.mjs",
    "visual:preview": "node scripts/visual-capture.mjs --operation preview",
    "visual:replay": "node scripts/visual-capture.mjs --operation replay",
    "visual:compare": "node scripts/visual-compare.mjs",
    "visual:reference": "node scripts/visual-reference.mjs",
    "visual:diagnostics": "node scripts/visual-diagnostics.mjs",
    "visual:blender": "node scripts/visual-blender.mjs",
    "visual:blender-bridge": "node scripts/visual-blender-bridge.mjs",
    "visual:verify-replay": "node scripts/visual-verify-replay.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "@types/three": "^0.185.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@gltf-transform/cli": "4.5.0",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "gltf-validator": "2.0.0-dev.3.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.63.0",
    "spectorjs": "0.9.33",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
